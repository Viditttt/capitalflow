# Copy to .env and fill in. NEVER commit .env. NEVER put a seed phrase or a
# private key that holds real funds in any file. Use throwaway test wallets only.

# --- Database ---
DATABASE_URL="postgresql://capitalflow:capitalflow@localhost:5432/capitalflow?schema=public"

# --- Chain (local Hardhat by default) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# --- Testnet deployment (Phase 7 only; leave blank for local work) ---
TESTNET_RPC_URL=
# Deployer key comes from Hardhat's encrypted keystore, not from this file.
EXPLORER_API_KEY=
